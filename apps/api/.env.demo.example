# Demo VM (pm2). Copy to apps/api/.env.prod on the VM and chmod 600.
#
# Optional keys are DELIBERATELY ABSENT. The API validates with z.string().min(1).optional(), so an empty
# line (e.g. FIREBASE_SERVICE_ACCOUNT_JSON=) crashes boot with "Invalid environment". Add a key only with a real value:
#   FIREBASE_SERVICE_ACCOUNT_JSON  (push; omitted => push off, Inbox still works)
#   CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET
#   GOOGLE_MAPS_API_KEY
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / MAIL_FROM / PASSWORD_RESET_OWNER_EMAIL

NODE_ENV=production
PORT=4030
LOG_LEVEL=info

# Its own database on Atlas (never shared with another app).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edhas-demo?retryWrites=true&w=majority

CORS_ORIGINS=https://demo.edhas.co.in

# Two different values each: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST_FACTOR=12
